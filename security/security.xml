<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_donialink_agent" model="ir.module.category">
        <field name="name">DoniaLink Agent</field>
        <field name="description">Access of the DoniaLink control platform to this database</field>
        <field name="sequence">90</field>
    </record>

    <!-- Users in this group may call the agent API (with an agent-scoped API key).
         Only the technical user "DoniaLink Agent" should be in it. Modules that add
         tools give this user the extra read groups their tools need. -->
    <record id="group_agent_api" model="res.groups">
        <field name="name">Agent API</field>
        <field name="comment">Technical: may call /donialink/agent/v1 with an agent API key.</field>
        <field name="category_id" ref="module_category_donialink_agent"/>
    </record>

    <!-- DoniaLink staff only: the connector's settings, menus, keys, audit log and test console.
         Not implied by Administration / Settings and hidden from the user form, so the client's own
         administrators don't see it. Granted through the secret link /donialink/agent/admin/<token>
         (token: option donialink_agent_admin_token of the server configuration file). -->
    <record id="group_donialink_technical" model="res.groups">
        <field name="name">DoniaLink Technical</field>
        <field name="comment">DoniaLink staff: manage the DoniaLink Agent Connector of this database.</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

</odoo>
