<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.donialink.agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="DoniaLink" string="DoniaLink" name="donialink_agent" groups="donialink_agent.group_donialink_technical">
                <block title="DoniaLink Agent" name="donialink_agent_settings">
                    <setting id="donialink_agent_api_enabled" string="Agent API"
                             help="Let the DoniaLink platform read this database. Off = nothing can call it.">
                        <field name="donialink_agent_api_enabled"/>
                        <div class="mt8" invisible="not donialink_agent_api_enabled">
                            <button name="%(action_agent_api_keys)d" type="action" string="API Keys"
                                    icon="oi-arrow-right" class="btn-link"/>
                            <button name="%(action_agent_log)d" type="action" string="Audit Log"
                                    icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="donialink_agent_allowed_ips" string="Allowed IP Addresses"
                             help="Gateway addresses allowed to call the API. Empty = any address.">
                        <field name="donialink_agent_allowed_ips" placeholder="e.g. 10.8.0.1, 10.8.0.0/24"/>
                    </setting>
                    <setting id="donialink_agent_allow_generic_read" string="Generic Read Tools"
                             help="describe_model, search_records and aggregate_records, limited by the agent user's access rights">
                        <field name="donialink_agent_allow_generic_read"/>
                    </setting>
                    <setting id="donialink_agent_business_tz" string="Business Timezone"
                             help="Reports cut days in this timezone (cafés often sell past midnight).">
                        <field name="donialink_agent_business_tz" placeholder="Administrator's timezone"/>
                    </setting>
                    <setting id="donialink_agent_log_retention_days" string="Keep Audit Log"
                             help="Older entries are deleted every day. 0 = keep forever.">
                        <div>
                            <field name="donialink_agent_log_retention_days" class="oe_inline"/>
                            <span class="ms-1">days</span>
                        </div>
                    </setting>
                </block>
                <block title="DoniaLink Platform" name="donialink_agent_platform_settings">
                    <setting id="donialink_agent_platform" string="Platform Address"
                             help="The DoniaLink app that manages this database. It can read this database only after Connect.">
                        <field name="donialink_agent_platform_url" placeholder="https://app.donialink.com"/>
                    </setting>
                    <setting id="donialink_agent_platform_announce" string="Show on platform"
                             help="Every 15 minutes, tell the platform this database exists (name, address, versions; no access).">
                        <field name="donialink_agent_platform_announce"/>
                    </setting>
                    <setting id="donialink_agent_platform_connection" string="Connection">
                        <field name="donialink_agent_platform_status" invisible="1"/>
                        <div><field name="donialink_agent_platform_summary" class="fw-bold"/></div>
                        <div class="text-muted" invisible="not donialink_agent_platform_client">
                            Client: <field name="donialink_agent_platform_client" class="oe_inline"/>
                        </div>
                        <div class="text-muted" invisible="not donialink_agent_platform_last_seen">
                            Last contact: <field name="donialink_agent_platform_last_seen" class="oe_inline"/>
                        </div>
                        <div class="text-danger" invisible="not donialink_agent_platform_last_error">
                            Last error: <field name="donialink_agent_platform_last_error" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <button name="action_donialink_platform_connect" type="object"
                                    string="Connect to platform" class="btn-primary"
                                    invisible="donialink_agent_platform_status == 'connected'"/>
                            <button name="action_donialink_platform_heartbeat" type="object"
                                    string="Contact platform now" class="btn-link" icon="oi-arrow-right"/>
                            <button name="action_donialink_platform_disconnect" type="object"
                                    string="Disconnect" class="btn-link text-danger" icon="fa-unlink"
                                    invisible="donialink_agent_platform_status not in ('connected', 'pending')"
                                    confirm="Disconnect from the platform? Its agent key is revoked now."/>
                        </div>
                    </setting>
                    <setting id="donialink_agent_lock" string="Hide these settings"
                             help="Hides DoniaLink settings and menus for you again. To get them back, open your DoniaLink admin link.">
                        <button name="action_donialink_lock" type="object" string="Hide DoniaLink settings"
                                class="btn-link" icon="fa-lock"/>
                    </setting>
                </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
